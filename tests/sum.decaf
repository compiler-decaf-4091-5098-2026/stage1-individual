import print;
int data[0x8], count;

long sum(int n) {
    long total;
    int i;
    total = 0L;
    for (i = 0; i < n && i < len(data); i++) {
        total += long(data[i]);
    }
    return total;
}

void main() {
    if (count > 0) {
        print("sum", sum(count));
    } else {
        print("empty");
    }
}
