import printf;
int arr[5];
void main() {
  int i, sum;
  bool done;
  sum = 0;
  for (i = 0; i < len(arr); i++) {
    arr[i] = i * 2;
    sum += arr[i];
    if (sum > 10) {
      break;
    } else {
      continue;
    }
  }
  while (!done) {
    done = true;
  }
  i--;
  sum -= 1;
  sum *= 2;
  sum /= 3;
  sum %= 4;
  printf("sum = %d\n", sum);
  return;
}
